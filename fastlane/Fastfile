default_platform(:ios)

platform :ios do
  desc "运行 SwiftLint 代码规范检查"
  lane :lint do
    # 获取项目根目录（fastlane 目录的父目录）
    # __FILE__ 是 Fastfile 的路径，例如 /path/to/project/fastlane/Fastfile
    # File.dirname(__FILE__) 得到 fastlane 目录
    # 再往上一级就是项目根目录
    fastlane_dir = File.dirname(__FILE__)
    project_root = File.expand_path("..", fastlane_dir)
    config_path = File.join(project_root, "swiftlint.yml")
    
    # 输出调试信息
    UI.message("Fastfile 路径: #{__FILE__}")
    UI.message("fastlane 目录: #{fastlane_dir}")
    UI.message("项目根目录: #{project_root}")
    UI.message("配置文件路径: #{config_path}")
    
    # 验证配置文件是否存在
    unless File.exist?(config_path)
      UI.user_error!("SwiftLint 配置文件不存在: #{config_path}")
    end
    
    sh("swiftlint --config \"#{config_path}\"")
  end

  desc "执行单元测试"
  lane :tests do
    # 使用模拟器运行测试，不需要证书
    # 获取可用的 iPhone 模拟器
    destination = nil
    begin
      # 列出所有可用的模拟器
      available_devices = `xcrun simctl list devices available --json`.strip
      
      if available_devices.empty?
        UI.important("No simulator list available, using generic iOS Simulator")
        destination = "platform=iOS Simulator"
      else
        # 尝试解析 JSON 并找到第一个 iPhone 模拟器
        require 'json'
        devices_json = JSON.parse(available_devices)
        
        # 查找第一个可用的 iPhone 模拟器
        simulator_udid = nil
        simulator_name = nil
        
        devices_json["devices"].each do |runtime, devices|
          next unless runtime.include?("iOS")
          
          devices.each do |device|
            if device["name"].include?("iPhone") && device["isAvailable"] == true
              simulator_udid = device["udid"]
              simulator_name = device["name"]
              break
            end
          end
          break if simulator_udid
        end
        
        if simulator_udid && simulator_name
          # 启动模拟器
          UI.message("Booting simulator: #{simulator_name} (#{simulator_udid})")
          `xcrun simctl boot "#{simulator_udid}" 2>&1`
          
          # 等待模拟器启动
          sleep(5)
          
          destination = "platform=iOS Simulator,id=#{simulator_udid}"
          UI.message("Using iOS Simulator: #{simulator_name} (#{simulator_udid})")
        else
          UI.important("No available iPhone simulator found, using generic iOS Simulator")
          destination = "platform=iOS Simulator"
        end
      end
    rescue => ex
      UI.important("Error detecting simulator: #{ex.message}")
      UI.important("Using generic iOS Simulator destination")
      destination = "platform=iOS Simulator"
    end
    
    # 如果没有找到模拟器，使用通用 iOS Simulator
    destination ||= "platform=iOS Simulator"
    
    # 设置更长的超时时间
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "60"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "3"
    
    scan(
      project: "Smth.xcodeproj",
      scheme: "Smth",
      clean: true,
      code_coverage: false,
      skip_package_dependencies_resolution: false,
      destination: destination
    )
  end

  desc "CI 流程：Lint + 测试"
  lane :ci do
    lint
    tests
  end
end


