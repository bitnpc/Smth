default_platform(:ios)

# 辅助方法：获取项目根目录
def project_root
  @project_root ||= File.expand_path("..", File.dirname(__FILE__))
end

# 辅助方法：查找可用的 iOS 模拟器
def find_ios_simulator
  begin
    available_devices = `xcrun simctl list devices available --json`.strip
    return nil if available_devices.empty?
    
    require 'json'
    devices_json = JSON.parse(available_devices)
    
    devices_json["devices"].each do |runtime, devices|
      next unless runtime.include?("iOS")
      
      devices.each do |device|
        if device["name"].include?("iPhone") && device["isAvailable"] == true
          return {
            udid: device["udid"],
            name: device["name"]
          }
        end
      end
    end
  rescue => ex
    UI.important("Error detecting simulator: #{ex.message}")
  end
  
  nil
end

# 辅助方法：获取构建 destination
def get_build_destination(boot_simulator: false)
  simulator = find_ios_simulator
  
  if simulator
    if boot_simulator
      UI.message("Booting simulator: #{simulator[:name]} (#{simulator[:udid]})")
      `xcrun simctl boot "#{simulator[:udid]}" 2>&1`
      sleep(5)
    end
    "platform=iOS Simulator,id=#{simulator[:udid]}"
  else
    UI.important("No available iPhone simulator found, using generic iOS Simulator")
    "platform=iOS Simulator,name=iPhone 15 Pro"
  end
end

platform :ios do
  desc "运行 SwiftLint 代码规范检查"
  lane :lint do
    config_path = File.join(project_root, "swiftlint.yml")
    
    unless File.exist?(config_path)
      UI.user_error!("SwiftLint 配置文件不存在: #{config_path}")
    end
    
    sh("swiftlint --config \"#{config_path}\"")
  end

  desc "执行单元测试"
  lane :tests do
    # 检查 scheme 是否配置了测试操作
    scheme_path = File.join(project_root, "Smth.xcodeproj/xcshareddata/xcschemes/Smth.xcscheme")
    has_test_action = File.exist?(scheme_path) && 
                      (File.read(scheme_path).include?("<TestableReference") || 
                       File.read(scheme_path).include?("testTarget"))
    
    # 设置超时时间
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "60"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "3"
    
    project_path = File.join(project_root, "Smth.xcodeproj")
    
    if !has_test_action
      UI.important("No test action configured in scheme, skipping tests and just building the project")
      
      destination = get_build_destination(boot_simulator: false)
      
      Dir.chdir(project_root) do
        sh("xcodebuild clean build -project Smth.xcodeproj -scheme Smth -destination '#{destination}' -sdk iphonesimulator -skipPackagePluginValidation")
      end
      
      UI.success("Build completed successfully (no tests to run)")
    else
      destination = get_build_destination(boot_simulator: true)
      
      scan(
        project: project_path,
        scheme: "Smth",
        clean: true,
        code_coverage: false,
        skip_package_dependencies_resolution: false,
        destination: destination
      )
    end
  end

  desc "CI 流程：Lint + 测试"
  lane :ci do
    lint
    tests
  end
end


