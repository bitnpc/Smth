default_platform(:ios)

platform :ios do
  desc "运行 SwiftLint 代码规范检查"
  lane :lint do
    # 获取项目根目录（fastlane 目录的父目录）
    # __FILE__ 是 Fastfile 的路径，例如 /path/to/project/fastlane/Fastfile
    # File.dirname(__FILE__) 得到 fastlane 目录
    # 再往上一级就是项目根目录
    fastlane_dir = File.dirname(__FILE__)
    project_root = File.expand_path("..", fastlane_dir)
    config_path = File.join(project_root, "swiftlint.yml")
    
    # 输出调试信息
    UI.message("Fastfile 路径: #{__FILE__}")
    UI.message("fastlane 目录: #{fastlane_dir}")
    UI.message("项目根目录: #{project_root}")
    UI.message("配置文件路径: #{config_path}")
    
    # 验证配置文件是否存在
    unless File.exist?(config_path)
      UI.user_error!("SwiftLint 配置文件不存在: #{config_path}")
    end
    
    sh("swiftlint --config \"#{config_path}\"")
  end

  desc "执行单元测试"
  lane :tests do
    # 使用模拟器运行测试，不需要证书
    # 获取可用的 iPhone 模拟器
    destination = nil
    begin
      simulator_list = `xcrun simctl list devices available | grep -i 'iPhone' | head -1`.strip
      
      if simulator_list.nil? || simulator_list.empty?
        UI.important("No iOS Simulator available, using macOS")
        destination = "platform=macOS"
      else
        # 提取模拟器名称（格式：iPhone 15 Pro (XXXX-XXXX-XXXX-XXXX)）
        match = simulator_list.match(/^\s*(.+?)\s*\(/)
        simulator_name = match ? match[1].strip : "iPhone 15 Pro"
        destination = "platform=iOS Simulator,name=#{simulator_name}"
        UI.message("Using iOS Simulator: #{simulator_name}")
      end
    rescue => ex
      UI.important("Error detecting simulator, using macOS: #{ex.message}")
      destination = "platform=macOS"
    end
    
    # 如果没有找到模拟器，使用 macOS
    destination ||= "platform=macOS"
    
    scan(
      project: "Smth.xcodeproj",
      scheme: "Smth",
      clean: true,
      code_coverage: false,
      skip_package_dependencies_resolution: false,
      destination: destination
    )
  end

  desc "CI 流程：Lint + 测试"
  lane :ci do
    lint
    tests
  end
end


